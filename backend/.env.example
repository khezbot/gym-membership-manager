# Copy this file to .env and fill in real values. Never commit .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gym_membership
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=<long random string>
PORT=5001
# Only needed for local development (React dev server)
CORS_ORIGIN=http://localhost:3000
# Used once by `npm run seed` to create the first admin account
ADMIN_NAME=Gym Admin
ADMIN_EMAIL=admin@gym.local
ADMIN_PASSWORD=<choose a strong password>
